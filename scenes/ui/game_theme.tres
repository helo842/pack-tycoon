[gd_resource type="Theme" load_steps=2 format=3]

; La letra por defecto es la de TEXTO, font_texto.fnt (mayusculas y minusculas,
; pixel art, de tools/make_font.py). Los titulos y los numeros los ponen UIKit y
; PixelNumber; ver la cabecera de scripts/ui/ui_kit.gd. Los tamanos salen a
; escala entera porque UIKit los ajusta al multiplo de 7 (FONT_STEP).
;
; La letra se pinta en blanco puro a proposito: Godot la tiñe con el font_color.

[ext_resource type="FontFile" path="res://Sprites/font/font_texto.fnt" id="1_font"]

[resource]
default_font = ExtResource("1_font")
default_font_size = 42
Label/colors/font_color = Color(0.988235, 0.92549, 0.768627, 1)
Button/colors/font_color = Color(0.988235, 0.92549, 0.768627, 1)
Button/colors/font_hover_color = Color(1, 0.960784, 0.858824, 1)
Button/colors/font_pressed_color = Color(0.831373, 0.721569, 0.533333, 1)
Button/font_sizes/font_size = 42
